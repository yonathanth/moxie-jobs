# Gursha Jobs on the VPS: copy to ~/apps/moxie-jobs/.env and fill in the blanks.
# (Next to GoMoxie: its backend is on :4030, frontend :3002. Gursha Jobs API :4040, web :3003.)

NODE_ENV=production
PORT=4040
LOG_LEVEL=info

# Database (Neon, production branch). Pooled host for the app, direct host for migrations.
DATABASE_URL=
DIRECT_URL=

# Telegram bot: the production bot (your laptop uses a separate dev bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gomoxiebot
BOT_ENABLED=true
BOT_MODE=webhook
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Public addresses (Cloudflare DNS → Nginx → the ports above)
PUBLIC_API_URL=https://jobs-api.gomoxie.app
WEB_APP_URL=https://jobs.gomoxie.app
CORS_ORIGINS=https://jobs.gomoxie.app

# openssl rand -hex 48
JWT_SECRET=
JWT_TTL_SECONDS=86400
ALLOW_DEV_AUTH=false
# Your Telegram user id (comma-separated for more admins)
ADMIN_TELEGRAM_IDS=

# Telegram listener (the user account that reads channels). TG_SESSION: run
#   cd ~/apps/moxie-jobs/apps/worker && npx pnpm@10.13.1 tg:login
# once on the server and paste the session it prints. Don't reuse your laptop's session.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=
LISTENER_ENABLED=true
POLL_INTERVAL_SECONDS=90
PIPELINE_CONCURRENCY=3

# AI extraction (same values as your local .env)
AI_PROVIDER=vertex
AI_MODEL=gemini-3.5-flash-lite
AI_REASONING_EFFORT=none
GEMINI_API_KEY=
VERTEX_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Payments (SantimPay production merchant; PEM key on one line with literal \n)
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=
SANTIMPAY_BASE_URL=https://services.santimpay.com/api/v1/gateway

# CV engine: GoMoxie's backend on the same server. The key must match
# PARTNER_API_KEYS=moxiejobs:<same secret> in GoMoxie's .env. openssl rand -hex 24
GOMOXIE_API_URL=http://localhost:4030
GOMOXIE_PARTNER_KEY=
GOMOXIE_PUBLIC_URL=https://api.gomoxie.app

# Web app (read at build time; the deploy copies these into apps/web/.env.production)
NEXT_PUBLIC_API_URL=https://jobs-api.gomoxie.app
NEXT_PUBLIC_BOT_USERNAME=gomoxiebot
