# Copy to apps/web/.env.local for local dev; set in Vercel for production.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BOT_USERNAME=gomoxiebot
# Local dev only: sign in without Telegram (API needs ALLOW_DEV_AUTH=true). Never set in production.
NEXT_PUBLIC_DEV_AUTH=true
# Dev only: sign in as this Telegram user id (yours) so bot alerts reach your chat.
NEXT_PUBLIC_DEV_TELEGRAM_ID=
