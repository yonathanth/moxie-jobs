# Copy to .env (repo root) for local dev. In production, set these on the server.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (Neon). DATABASE_URL = pooled host (-pooler) for the app; DIRECT_URL = direct host for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gomoxiebot
BOT_ENABLED=true
# polling (local dev) | webhook (production)
BOT_MODE=polling
# Random 16-256 chars [A-Za-z0-9_-]; required for webhook mode.
TELEGRAM_WEBHOOK_SECRET=

# Public URLs. Mini App buttons only work with https (use a tunnel in dev).
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Sessions: long random string (openssl rand -hex 48)
JWT_SECRET=
JWT_TTL_SECONDS=86400

# Dev-only sign-in without Telegram. Must be false in production.
ALLOW_DEV_AUTH=true
# Comma-separated Telegram user ids with admin rights
ADMIN_TELEGRAM_IDS=

# --- Next milestones ---
# Telegram listener (user account, from my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_PHONE=+2519XXXXXXXX
TG_SESSION=
# AI extraction
AI_PROVIDER=vertex
AI_MODEL=gemini-3.5-flash-lite
AI_REASONING_EFFORT=none
GEMINI_API_KEY=
VERTEX_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=global
LISTENER_ENABLED=true
POLL_INTERVAL_SECONDS=90
PIPELINE_CONCURRENCY=3
# Payments (SantimPay)
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=
# Production gateway; SantimPay also has https://testnet.santimpay.com/api/v1/gateway
SANTIMPAY_BASE_URL=https://services.santimpay.com/api/v1/gateway
